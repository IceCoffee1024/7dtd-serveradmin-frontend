  "scripts": {
    "api:gen": "openapi-ts",
    "api:check": "pnpm api:gen && pnpm typecheck",
    "build:analyze": "pnpm build && node scripts/analyze-build.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "locale:check": "node scripts/check-locales.mjs",
    "live:acceptance": "node scripts/live-acceptance-checklist.mjs",
    "preview": "vite preview",
    "smoke:live": "node scripts/live-smoke.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "verify:local": "pnpm api:gen && pnpm typecheck && pnpm lint && pnpm test:unit && pnpm locale:check && pnpm build:analyze",
    "docs:dev": "vitepress dev docs\\vitepress",
    "docs:build": "vitepress build docs\\vitepress",
    "docs:preview": "vitepress preview docs\\vitepress"
  },
