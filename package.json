{
  "name": "7dtd-serveradmin-frontend",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "license": "MIT",
  "homepage": "https://github.com/IceCoffee1024",
  "repository": {
    "url": "https://github.com/IceCoffee1024/7dtd-serveradmin-frontend"
  },
  "scripts": {
    "api:gen": "openapi-ts",
    "api:check": "pnpm api:gen && pnpm typecheck",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "contract:check": "pnpm api:gen && pnpm typecheck && pnpm typecheck:playwright && pnpm locale:check && pnpm build && pnpm visual:critical",
    "locale:check": "node scripts/check-locales.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:playwright": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --skipLibCheck playwright.config.ts",
    "visual:discord": "playwright test tests/visual/discord-integration.spec.ts",
    "visual:critical": "playwright test tests/visual/discord-integration.spec.ts tests/visual/economy-shop.spec.ts tests/visual/event-automation-rules.spec.ts tests/visual/critical-interactions.spec.ts tests/visual/geoip-access-control.spec.ts"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@imengyu/vue3-context-menu": "^1.5.4",
    "@pinia/colada": "^1.3.1",
    "@valibot/i18n": "^1.2.0",
    "@vueuse/core": "^14.3.0",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.1",
    "es-toolkit": "^1.47.0",
    "event-source-plus": "^0.1.15",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ol": "^10.9.0",
    "ol-ext": "^4.0.38",
    "ol-layerswitcher": "^4.1.2",
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.25",
    "type-fest": "^5.6.0",
    "uuid": "^14.0.0",
    "valibot": "^1.4.1",
    "vue": "^3.5.35",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@hey-api/openapi-ts": "0.97.3",
    "@iconify-json/ep": "^1.2.4",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/nprogress": "^0.2.3",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.6.8",
    "@unocss/eslint-plugin": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "unocss": "^66.7.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.9",
    "vue-tsc": "3.3.2"
  }
}
